{
  "version": 2,
  "builds": [
    {
      "src": "api/sheet-order-fix.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/catalogue-images.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/dashboard-data.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/catalogue-images",
      "dest": "api/catalogue-images.js"
    },
    {
      "src": "/api/dashboard-data",
      "dest": "api/dashboard-data.js"
    },
    {
      "src": "/dashboard/?",
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "/dashboard/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/sheet-order-fix.js"
    }
  ]
}
